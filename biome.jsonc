{
  "$schema": "https://biomejs.dev/schemas/2.1.2/schema.json",
  "extends": ["ultracite"],
  "formatter": {
    "enabled": true,
    "lineWidth": 100,
    "indentWidth": 2,
    "indentStyle": "space",
    "lineEnding": "lf",
    "bracketSpacing": true
  },
  "linter": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double", // 문자열에 사용할 따옴표 스타일
      "semicolons": "asNeeded", // 세미콜론 사용 여부
      "arrowParentheses": "asNeeded", // 화살표 함수의 괄호 사용 여부
      "jsxQuoteStyle": "double", // JSX에서 문자열에 사용할 따옴표 스타일
      "trailingCommas": "es5", // 후행 쉼표 사용 여부
      "bracketSameLine": false // 여는 괄호와 같은 줄에 닫는 괄호를 위치시킬지 여부
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
